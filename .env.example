# --- GitHub App ---
# From: GitHub -> Settings -> Developer settings -> GitHub Apps -> your app
GITHUB_APP_ID=123456
# PEM private key. Either paste the whole key (with \n for newlines) or
# reference it; the loader normalizes \n and wraps bare keys in PEM headers.
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----
# From: GitHub App -> Webhooks -> Webhook secret
WEBHOOK_SECRET=your-webhook-secret
# The bot login of this app (shown in the Reviewers dropdown), e.g. "ai-review[bot]".
# PRs are auto-reviewed only when this bot is requested as a reviewer.
BOT_LOGIN=ai-review[bot]
# --- LiteLLM (OpenAI-compatible) ---
LITELLM_BASE_URL=https://your-litellm-host/v1
LITELLM_API_KEY=sk-your-litellm-key
LITELLM_MODEL=your-model-name
# LLM_TIMEOUT_MS=180000
# Output token cap (inputs can be large).
# LLM_MAX_TOKENS=8192
# Low temperature for consistent reviews.
# LLM_TEMPERATURE=0.1

# --- Review behaviour ---
# auto: REQUEST_CHANGES if critical issues, APPROVE otherwise (recommended)
# request_changes_if_critical: REQUEST_CHANGES if critical, plain review otherwise
# comment: always post a plain review
REVIEW_MODE=auto
# MAX_DIFF_CHARS=800000
# MAX_CONTEXT_FILES=10
# MAX_COMMENTS=25
# Dependency lock files (npm/pnpm/yarn/Go/Cargo/Python/Ruby/PHP) + generated assets.
# SKIP_PATTERNS=package-lock.json,yarn.lock,pnpm-lock.yaml,go.sum,Cargo.lock,composer.lock,Gemfile.lock,Pipfile.lock,poetry.lock,uv.lock,bun.lock,*.lock,*.min.js,*.min.css,*.map,*.snap

# --- Local dev server ---
PORT=8080
